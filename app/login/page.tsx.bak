import { Box, Paper, Stack, Typography } from "@mui/material";
import LoginCard from "@/components/auth/LoginCard";

export default function LoginPage() {
  return (
    <Box
      sx={{
        minHeight: "100vh",
        display: "grid",
        gridTemplateColumns: { xs: "1fr", lg: "1.1fr 0.9fr" },
        bgcolor: "#e9eef4",
      }}
    >
      <Box
        sx={{
          position: "relative",
          display: "flex",
          alignItems: "center",
          overflow: "hidden",
          p: { xs: 3, md: 6 },
          color: "common.white",
          bgcolor: "#0a4f5f",
        }}
      >
        <Box
          sx={{
            position: "absolute",
            inset: 0,
            background:
              "linear-gradient(135deg, rgba(2,48,71,0.98), rgba(10,79,95,0.92), rgba(25,118,210,0.74))",
          }}
        />
        <Box
          sx={{
            position: "absolute",
            width: 540,
            height: 540,
            right: -180,
            top: -140,
            borderRadius: "50%",
            border: "90px solid rgba(255,255,255,0.08)",
          }}
        />
        <Box
          sx={{
            position: "absolute",
            left: { xs: -80, md: 70 },
            bottom: { xs: -110, md: -80 },
            width: 360,
            height: 360,
            borderRadius: "50%",
            border: "1px solid rgba(255,255,255,0.18)",
          }}
        />

        <Stack
          spacing={4}
          sx={{
            position: "relative",
            width: "100%",
            maxWidth: 760,
          }}
        >
          <Box>
            <Box
              sx={{
                display: "inline-flex",
                alignItems: "center",
                gap: 0.75,
                mb: 2,
                px: 1.25,
                py: 0.55,
                borderRadius: 99,
                color: "common.white",
                bgcolor: "rgba(255,255,255,0.14)",
              }}
            >
              <QrCodeScanner fontSize="small" />
              <Typography variant="body2" sx={{ fontWeight: 700 }}>
                Kiosko y recorridos de abastecimiento.
              </Typography>
            </Box>
            <Typography
