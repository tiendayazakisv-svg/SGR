            }}
          >
            <Metric icon={<Inventory2 />} title="Entrada" value="Tolvas" />
            <Metric icon={<LocalShipping />} title="Reparto" value="Lineas" />
            <Metric icon={<AccessTime />} title="Cumplimiento" value="Tiempo" />
