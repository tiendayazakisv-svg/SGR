                maxWidth: 560,
              }}
            >
              Control de tiempo de abastecimiento y cumplimiento.
            </Typography>
          </Box>

          <Box
            sx={{
              display: "grid",
              gridTemplateColumns: { xs: "1fr", sm: "repeat(3, 1fr)" },
